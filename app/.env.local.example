# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (pooled). Required.
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# NextAuth secret — generate with: openssl rand -base64 32. Required.
AUTH_SECRET=your-auth-secret-here

# Shared secret for the Vercel Cron backup route (/api/cron/backup).
# Set the same value as a Vercel env var so Cron sends it as a Bearer token.
CRON_SECRET=your-cron-secret-here
